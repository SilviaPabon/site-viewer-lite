{
  "name": "site-viewer-lite",
  "private": true,
  "workspaces": [
    "api",
    "visor-web"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup-clouds.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w visor-web\"",
    "test": "npm test -w api",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "npm run setup",
    "start": "npm install && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.9.10"
  }
}
